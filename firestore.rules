rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // แก้ PUT_OWNER_UID เป็น UID ของเจ้าของร้าน (Firebase Console > Authentication > Users)
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == "PUT_OWNER_UID";
    }
  }
}
