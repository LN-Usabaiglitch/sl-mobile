rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ✅ หน้าสถานะสำหรับลูกค้า (สแกน QR): อ่านได้ทีละรายการเท่านั้น ห้าม list, ห้ามเขียน
    match /public/{token} {
      allow get: if true;
      allow list: if false;
      allow write: if request.auth != null && request.auth.uid == "PUT_OWNER_UID";
    }
    // แก้ PUT_OWNER_UID เป็น UID ของเจ้าของร้าน (Firebase Console > Authentication > Users)
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == "PUT_OWNER_UID";
    }
  }
}
