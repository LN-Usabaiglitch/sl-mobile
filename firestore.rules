rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // เพิ่มบล็อกนี้ (ไม่ต้องใส่ UID): ให้ลูกค้าสแกน QR อ่านหน้าสถานะได้ทีละรายการ ห้าม list
    match /public/{token} {
      allow get: if true;
      allow list: if false;
    }
    // กฎเดิมของคุณ (เจ้าของคนเดียว) คงไว้เหมือนเดิม — แก้ PUT_OWNER_UID เป็น UID จริง
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == "PUT_OWNER_UID";
    }
  }
}
